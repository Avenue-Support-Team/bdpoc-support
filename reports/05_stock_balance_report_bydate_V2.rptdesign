                        <property name="name">itscommodity</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">15</property>
                        <property name="name">quantityTransfer</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">16</property>
                        <property name="name">quantityReceipt</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">17</property>
                        <property name="name">loadedcost</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[inTransit = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
inTransit.open();

var sqlText = new String();

if(params["item"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.itemnum", params["item"].toUpperCase());
}

if(params["commoditygroup"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("item.commgroup", params["commoditygroup"].toUpperCase());
}

if(params["storeloc"].value &amp;&amp; params["storeloc"].toUpperCase() != "TRANSIT") {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.location", params["storeloc"].toUpperCase());
}

// Add query to sqlText variable.
sqlText = "select distinct inventory.itemnum as itemcode, inventory.issueunit as unit"
+ " , nvl(item.description,' ') as itemdescription "
+ " , (select nvl(sum(m1.quantity/m1.conversion),0) from matrectrans m1 where m1.itemnum = matrectrans.itemnum and m1.invuseid = matrectrans.invuseid AND m1.shipmentlinenum =  matrectrans.shipmentlinenum and m1.issuetype ='SHIPRECEIPT' " 
+ " and trunc(m1.actualdate) <= '"+ params["reportdate"].value +"') quantityReceipt "
+ " , rowtocol('select binnum from invbalances where itemnum=''' || matrectrans.itemnum || ''' and curbal > 0') as binnum"
+ " , nvl(inventory.modelnum,'N/A') as partno, nvl(inventory.serialno,'N/A') as serialno,"
+ " matrectrans.quantity/conversion quantityTransfer, matrectrans.unitcost, matrectrans.loadedcost loadedcost, matrectrans.linecost linecostTransfer , "
+" item.criticality as itscriticality, item.commoditygroup as itscommoditygroup, item.commodity as itscommodity ,shipmentlinenum "
+ " from inventory "
+ " left join matrectrans on inventory.itemnum = matrectrans.itemnum and inventory.location = matrectrans.fromstoreloc"
+ " join item on matrectrans.itemnum = item.itemnum and item.itemtype = 'ITEM' "
+ " left join alndomain cm on cm.value = item.commgroup and cm.domainid = 'COMMGROUP'"
+ " left join invuse on invuse.invuseid = matrectrans.invuseid "
// Include the Maximo where clause
+ " where " + params["where"]
+ " and matrectrans.issuetype = 'SHIPTRANSFER' "
+ " and invuse.receipts in ('PARTIAL','NONE','COMPLETE') "
+ " and trunc(matrectrans.actualdate) <= '"+ params["reportdate"].value +"' "
+ " and BD1_TRANSFER_NOT_RECEIPT (matrectrans.itemnum,to_date('"+ params["reportdate"].value +"','dd/mon/yyyy hh24:mi'), inventory.location,matrectrans.invuseid) = 1 "
+ " order by itemcode ";

reportContext.setPersistentGlobalVariable("sql", sqlText);
inTransit.setQuery(sqlText);]]></method>
            <method name="fetch"><![CDATA[if (!inTransit.fetch())
	return (false);

// Add a line for each output column
// The specific get method should match the data type of the output column.
row["itemcode"] = inTransit.getString("itemcode");	
row["unit"] = inTransit.getString("unit");
row["itemdescription"] = inTransit.getString("itemdescription");
row["binnum"] = inTransit.getString("binnum");
row["serialno"] = inTransit.getString("serialno");
row["partno"] = inTransit.getString("partno");
row["unitcost"] = inTransit.getFloat("unitcost");
row["linecost"] = inTransit.getDouble("unitcost");
row["itscriticality"] = inTransit.getString("itscriticality");
row["itscommoditygroup"] = inTransit.getString("itscommoditygroup");
row["itscommodity"] = inTransit.getString("itscommodity");

if ((inTransit.getDouble("quantityTransfer") == inTransit.getDouble("quantityReceipt")))
	{
	   row["quantity"] = 0;
	   row["linecost"] = 0;
	}
	else
//	if (inTransit.getDouble("quantityReceipt") == 0)
	{
	   row["quantity"] = inTransit.getDouble("quantityReceipt") - inTransit.getDouble("quantityTransfer");
	   row["linecost"] = inTransit.getDouble("loadedcost") /  inTransit.getDouble("quantityTransfer");
	}
return (true);]]></method>
        </script-data-set>
    </data-sets>
