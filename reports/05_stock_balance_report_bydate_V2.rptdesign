            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[maximoDataSet = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
maximoDataSet.open();

var sqlText = new String();

if(params["item"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.itemnum", params["item"].toUpperCase());
}

if(params["commoditygroup"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("item.commgroup", params["commoditygroup"].toUpperCase());
}

if(params["storeloc"].value &amp;&amp; params["storeloc"].toUpperCase() != "TRANSIT") {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.location", params["storeloc"].toUpperCase());
}

// Add query to sqlText variable.
sqlText = "select inventory.itemnum as itemcode, inventory.issueunit as unit"
+ " , nvl((select gl.COMPTEXT from GLCOMPONENTS gl where gl.COMPVALUE = GetBudgetCode(inventory.CONTROLACC) and rownum=1),'NONE') as gldescription"
+ " , nvl(item.description,' ') as itemdescription, inventory.location"
+ " , rowtocol('select binnum from invbalances where itemnum=''' || inventory.itemnum || '''"
+ " and location =''' || inventory.location || ''' and curbal > 0') as binnum"
+ " , nvl(inventory.modelnum,'N/A') as partno, nvl(inventory.serialno,'N/A') as serialno, "
+ " nvl(item.commgroup, 'N/A') commgroup, nvl(cm.description,'Not Categorized') comgrpdesc, inventory.minlevel, inventory.maxlevel, "
+ " BD1_OPENING_BL_V2(inventory.itemnum, to_date('"+ params["reportdate"].value +" 23:59','dd/mon/yyyy hh24:mi'),to_date('"+ params["reportdate"].value +" 23:59','dd/mon/yyyy hh24:mi'), inventory.location) as currentbalance,"
+ " BD1_OPENING_BL_Q(inventory.itemnum,to_date('"+ params["reportdate"].value +" 23:59','dd/mon/yyyy hh24:mi'),to_date('"+ params["reportdate"].value +" 23:59','dd/mon/yyyy hh24:mi'), inventory.location) as amount , "
+ " item.criticality as criticality, item.commodity "
+ " from inventory "
+ " join item on inventory.itemnum=item.itemnum  "
+ " left join invcost inc on inc.itemnum = inventory.itemnum and inc.location = inventory.location"
+ " left join alndomain cm on cm.value = item.commgroup and cm.domainid = 'COMMGROUP'"
// Include the Maximo where clause
+ " where " + params["where"]
+ " and (item.itemtype = 'ITEM' OR item.itemnum in ('21791','21792','19713','19714','19715','19716','19717','19718', '21497', '21498', '21499', '21500', '21501', '21502', '21503'))" 
+ " and BD1_OPENING_BL_V2(inventory.itemnum, to_date('"+ params["reportdate"].value +" 23:59','dd/mon/yyyy hh24:mi'),to_date('"+ params["reportdate"].value +" 23:59','dd/mon/yyyy hh24:mi'), inventory.location) <> 0"
+ " order by itemcode ";

reportContext.setPersistentGlobalVariable("sql1", sqlText);
maximoDataSet.setQuery(sqlText);]]></method>
            <method name="fetch"><![CDATA[if (!maximoDataSet.fetch())
	return (false);

// Add a line for each output column
// The specific get method should match the data type of the output column.
row["itemcode"] = maximoDataSet.getString("itemcode");	
row["unit"] = maximoDataSet.getString("unit");
row["gldescription"] = maximoDataSet.getString("gldescription");
row["itemdescription"] = maximoDataSet.getString("itemdescription");
row["currentbalance"] = maximoDataSet.getFloat("currentbalance");
row["binnum"] = maximoDataSet.getString("binnum");
row["serialno"] = maximoDataSet.getString("serialno");
row["partno"] = maximoDataSet.getString("partno");
row["amount"] = maximoDataSet.getFloat("amount");
row["commoditygroup"] = maximoDataSet.getString("commgroup");
row["comgrpdesc"] = maximoDataSet.getString("comgrpdesc");
row["location"] = maximoDataSet.getString("location");
row["minlevel"] = maximoDataSet.getFloat("minlevel");
row["maxlevel"] = maximoDataSet.getFloat("maxlevel");

row["criticality"] = maximoDataSet.getString("criticality");

row["commodity"] = maximoDataSet.getString("commodity");

if (maximoDataSet.getFloat("currentbalance") == 0)
{
   row["unitprice"] = 0;
}
else
{
    row["unitprice"] = maximoDataSet.getFloat("amount") / maximoDataSet.getFloat("currentbalance");
}

//if (params["storeloc"].toUpperCase() == "TRANSIT")
//	storeloc = 1;
//else
//	storeloc = 0;
return (true);]]></method>
