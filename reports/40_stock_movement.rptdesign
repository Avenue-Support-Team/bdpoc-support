            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[maximoDataSet = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
maximoDataSet.open();

var sqlText = new String();
var where = params["where"];
var pSite = new String();

if(params["storeroom"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.location", params["storeroom"].toUpperCase());
}

if(params["pItemnum"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.itemnum", params["pItemnum"].toUpperCase());
}

if(params["commoditygroup"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("i.commgroup", params["commoditygroup"].toUpperCase());
}

sqlText = "SELECT * FROM (" 
+  " SELECT inventory.itemnum, inventory.location, i.description,    i.abctype ,  I.VEDTYPE, I.COMMODITYGROUP comgr, I.COMMODITY comcode, inventory.issueunit, nvl(cm.description,'Not Categorized') comgrpdesc, "
+ " 			   BD1_OPENING_BL(inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), TO_DATE('" + params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location) openBL ,"
+ " 			   BD1_OPENING_BL(inventory.itemnum, to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'), TO_DATE('" + params["endDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), inventory.location) closeBL ,"
+ " 			   BD1_Ton_Theo_Ngay_C1 (inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'),inventory.location,inventory.siteid) openBL_Q ,"
+ " 			   '' closeBL_Q ,"
+ "			BD1_RECEIPT_IN_MONTH (inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location)  AS receipt ,"
+ "		    BD1_RECEIPT_IN_MONTH_Q (inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location)	AS receipt_Q ,"
+ "			BD1_ISSUE_IN_MONTH (inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location) AS issue ,"
+ "			BD1_ISSUE_IN_MONTH_Q (inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location) AS issue_Q ,"
+ "			BD1_TRANSFER_IN_MONTH(inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location)  AS transfer ,"
+ "			BD1_TRANSFER_IN_RANGE(inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location)  AS transfer_Q ,"
+ " 		BD1_RETURN_IN_MONTH(inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location) AS return ,"
+ " 		BD1_RETURN_IN_MONTH_Q(inventory.itemnum, TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi'), to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi'),inventory.location) AS return_Q ,"
+ "			(SELECT nvl(sum(quantity), 0) "
+ "          FROM invtrans  "
+ "          WHERE itemnum = inventory.itemnum "
+ "             AND storeloc = inventory.location "
+ "             AND transtype IN ('RECBALADJ','CURBALADJ') "
+ "             AND transdate BETWEEN TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi') AND to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi') ) AS adjust ,"
+ "			(SELECT nvl(sum(linecost), 0) "
+ "			 FROM invtrans  "
+ "			 WHERE itemnum = inventory.itemnum "
+ "				AND storeloc = inventory.location "
+ "				AND transtype IN ('RECBALADJ','CURBALADJ','AVGCSTADJ') "
+ "				AND transdate BETWEEN TO_DATE('" + params["startDate"].value +" 00:01','dd/mon/yyyy hh24:mi') AND to_date('"+ params["endDate"].value +" 23:59','dd/mon/yyyy hh24:mi') ) AS adjust_Q"
+ "			FROM inventory "        
+ "      	JOIN item i ON i.itemnum = inventory.itemnum"
+ "         LEFT JOIN alndomain cm on cm.value = i.commgroup and cm.domainid = 'COMMGROUP' "
+ "      WHERE " + params["where"]
+ "        AND (i.itemtype = 'ITEM' OR i.itemnum in ('21791','21792','19713','19714','19715','19716','19717','19718', '21497', '21498', '21499', '21500', '21501', '21502', '21503'))" 
+ " ) WHERE openBL_Q <> 0 OR openBL <> 0 OR closeBL_Q <> 0 OR closeBL <> 0 OR issue_Q <> 0 OR issue <> 0 OR return_Q <> 0 OR return <> 0 OR receipt_Q <> 0 OR receipt <> 0 OR transfer_Q <> 0 OR transfer <> 0 OR adjust_Q <> 0 OR adjust <> 0 "
+ " ORDER by abctype asc, VEDTYPE desc "
;
//WHERE openBL <> 0 OR closeBL <> 0 OR issue <> 0 OR return <> 0 OR receipt <> 0 OR transfer <> 0 OR adjust <> 0 OR adjust_Q <> 0";


maximoDataSet.setQuery(sqlText);
//reportContext.setPersistentGlobalVariable("sql", sqlText)]]></method>
            <method name="fetch"><![CDATA[if (!maximoDataSet.fetch())
	return (false);

// Add a line for each output column
// The specific get method should match the data type of the output column.
   
	row["itemnum"] = maximoDataSet.getString("itemnum");	
	row["location"] = maximoDataSet.getString("location");
	row["description"] = maximoDataSet.getString("description");
	row["issueunit"] = maximoDataSet.getString("issueunit");
	row["openBL"] = maximoDataSet.getDouble("openBL");
	row["closeBL"] = maximoDataSet.getDouble("closeBL");
	row["openBL_Q"] = maximoDataSet.getDouble("openBL_Q");
	
	row["receipt"] = maximoDataSet.getDouble("receipt");
	row["receipt_Q"] = maximoDataSet.getDouble("receipt_Q");
	row["issue"] = maximoDataSet.getDouble("issue");
	row["issue_Q"] = maximoDataSet.getDouble("issue_Q");
	row["transfer"] = maximoDataSet.getDouble("transfer");
	row["transfer_Q"] = maximoDataSet.getDouble("transfer_Q");
	row["adjust"] = maximoDataSet.getDouble("adjust");
	row["adjust_Q"] = maximoDataSet.getDouble("adjust_Q");
	row["return"] = maximoDataSet.getDouble("return");
	row["return_Q"] = maximoDataSet.getDouble("return_Q");
	row["comgrpdesc"] = maximoDataSet.getString("comgrpdesc");
	//--------------------------
	row["abctype"] = maximoDataSet.getString("abctype");
	row["vedtype"] = maximoDataSet.getString("vedtype");
	row["comcode"] = maximoDataSet.getString("comcode");
	row["comgr"] = maximoDataSet.getString("comgr");
	//---------------------------------------------
//-----------SUM value kho cuoi ky
row["closeBL_Q"] = 
  (parseFloat(maximoDataSet.getDouble("openBL_Q"))
+ parseFloat(maximoDataSet.getDouble("receipt_Q")) 
+ parseFloat(maximoDataSet.getDouble("issue_Q")) 
+ parseFloat(maximoDataSet.getDouble("transfer_Q") )
+ parseFloat(maximoDataSet.getDouble("adjust_Q") )
+ parseFloat(maximoDataSet.getDouble("return_Q"))).toString();

return (true);]]></method>
        </script-data-set>
        <script-data-set name="inTransit" id="1309">
            <list-property name="resultSetHints">
                <structure>
                    <property name="position">1</property>
