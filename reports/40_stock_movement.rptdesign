            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[inTransit = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
inTransit.open();

var sqlText = new String();

if(params["storeroom"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.location", params["storeroom"].toUpperCase());
}

if(params["pItemnum"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("inventory.itemnum", params["pItemnum"].toUpperCase());
}

if(params["commoditygroup"].value) {
    params["where"]+= " and " + MXReportSqlFormat.createParamWhereClause("item.commgroup", params["commoditygroup"].toUpperCase());
}

// Add query to sqlText variable.
sqlText = "select distinct inventory.itemnum as itemcode, inventory.issueunit as unit"
+ " , nvl(item.description,' ') as itemdescription "
+ " , matrectrans.unitcost "
+ " , (select nvl(sum(m1.quantity/nullif(m1.conversion,0)),0) from matrectrans m1 where m1.itemnum = matrectrans.itemnum and m1.invuseid = matrectrans.invuseid AND m1.shipmentlinenum =  matrectrans.shipmentlinenum and m1.issuetype ='SHIPRECEIPT' and m1.matrectransid not in (198352,198354) "
+ " and trunc(m1.actualdate) <= '"+ params["endDate"].value +"') quantityReceipt "
+ " , (select nvl(sum(m1.quantity/nullif(m1.conversion,0)),0) from matrectrans m1 where m1.itemnum = matrectrans.itemnum and m1.invuseid = matrectrans.invuseid AND m1.shipmentlinenum =  matrectrans.shipmentlinenum and m1.issuetype ='SHIPCANCEL' " 
+ " and trunc(m1.actualdate) <= '"+ params["endDate"].value +"') quantityCancel "
+ " , matrectrans.loadedcost loadedcost, matrectrans.quantity quantityTransfer, shipmentlinenum"
+ " from inventory "
+ " left join matrectrans on inventory.itemnum = matrectrans.itemnum and inventory.location = matrectrans.fromstoreloc and matrectrans.matrectransid not in (198352,198354)"
+ " join item on matrectrans.itemnum = item.itemnum and item.itemtype = 'ITEM' "
+ " left join alndomain cm on cm.value = item.commoditygroup and cm.domainid = 'COMMGROUP'"
+ " left join invuse on invuse.invuseid = matrectrans.invuseid "
// Include the Maximo where clause
+ "      WHERE " + params["where"]
+ "         and matrectrans.issuetype in ('SHIPTRANSFER') "
+ "         and invuse.receipts in ('PARTIAL','NONE','COMPLETE') "
+ "         and trunc(matrectrans.actualdate) <= '"+ params["endDate"].value +"' "
+ "         and BD1_TRANSFER_NOT_RECEIPT (matrectrans.itemnum, to_date('"+ params["endDate"].value +"','dd/mon/yyyy hh24:mi'), inventory.location,matrectrans.invuseid) = 1 "
// Thay thế Alias bằng công thức đầy đủ để tránh lỗi SQL
+ "         and (matrectrans.quantity "  
+ "              - (select nvl(sum(m1.quantity/nullif(m1.conversion,0)),0) from matrectrans m1 where m1.itemnum = matrectrans.itemnum and m1.invuseid = matrectrans.invuseid AND m1.shipmentlinenum = matrectrans.shipmentlinenum and m1.issuetype ='SHIPRECEIPT' and m1.matrectransid not in (198352,198354) and trunc(m1.actualdate) <= '"+ params["endDate"].value +"') "  
+ "              - (select nvl(sum(m1.quantity/nullif(m1.conversion,0)),0) from matrectrans m1 where m1.itemnum = matrectrans.itemnum and m1.invuseid = matrectrans.invuseid AND m1.shipmentlinenum = matrectrans.shipmentlinenum and m1.issuetype ='SHIPCANCEL' and trunc(m1.actualdate) <= '"+ params["endDate"].value +"') "  
+ "             ) > 0 "
+ " order by itemcode ";


inTransit.setQuery(sqlText);
reportContext.setPersistentGlobalVariable("sql", sqlText)]]></method>
            <method name="fetch"><![CDATA[if (!inTransit.fetch())
	return (false);

// Add a line for each output column
// The specific get method should match the data type of the output column.
	

row["itemdescription"] = inTransit.getString("itemdescription");

//if(inTransit.getString("receiptref") == null)
//{
	row["itemcode"] = inTransit.getString("itemcode");
	row["unitcost"] = inTransit.getString("unitcost");
	//row["linecost"] = inTransit.getString("linecost");
	
	//if ((inTransit.getDouble("quantityTransfer") == inTransit.getDouble("quantityReceipt")))
	if ( (inTransit.getDouble("quantityTransfer") == inTransit.getDouble("quantityReceipt")) || (inTransit.getDouble("quantityTransfer") == inTransit.getDouble("quantityCancel")) )
	{
	   row["quantity"] = 0;
	   row["linecost"] = 0;
	}
	else
//	if (inTransit.getDouble("quantityReceipt") == 0)
	{
	   //row["quantity"] = inTransit.getDouble("quantityReceipt") - inTransit.getDouble("quantityTransfer");
	   row["quantity"] = inTransit.getDouble("quantityTransfer") - inTransit.getDouble("quantityReceipt");
	   row["linecost"] = inTransit.getDouble("loadedcost") / inTransit.getDouble("quantityTransfer") ;
	}
	if (row["quantity"]>0)
		row["transitcost"] = Math.abs( row["linecost"]*row["quantity"]);
	else
		row["transitcost"]=0;
//}
return (true);]]></method>
        </script-data-set>
    </data-sets>
